+            Assert.That(context.RoundItemUsage.HasUsed(itemData.ItemType), Is.False);
+            Assert.That(playerState.Gold, Is.EqualTo(100));
+        }
+        finally
+        {
+            DestroyDependencies(stageData, itemData);
+        }
+    }
